#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

// Cygnus keymap: ported from the QMK charybdis keymap
// (bk_qmk_userspace .../charybdis/3x5/keymaps/michalvanko), which is the
// reference layout — skeletyl stays frozen as an archive:
// - QMK combos: Q+P -> colemak, Q+; -> qwerty
// - gamepad layers (base / L1 / L2) with combo + keys to toggle on/off
// - mouse (pointer) layer on Z and /, like QMK POINTER_MOD:
//     n = left, u = up, i = right, , = down  (QMK reference, QWERTY labels)
// - tap the extra 6th thumb (charybdis keymap only used 5) for DEL; hold it
//   for the BT layer (profile select on z x c v, clear bonds on b)

#define QWERTY  0
#define COLEMAK 1
#define NAV     2
#define NUM     3
#define MOUSE   4
#define SYM     5
#define MEDIA   6
#define FUN     7
#define GAMEPAD 8
#define GP_L1   9
#define GP_L2   10
#define BT      11

/ {
    behaviors {
        // Charybdis-parity homerow mods: QMK default tap-hold behavior
        // (tap-preferred, TAPPING_TERM 200, no pinky distinction).
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Q+P: switch to colemak (QMK: DF(LAYER_COLEMAK))
        combo_to_colemak {
            timeout-ms = <50>;
            key-positions = <0 9>;
            bindings = <&to COLEMAK>;
        };

        // Q+SEMI: switch back to qwerty (QMK: DF(LAYER_BASE))
        combo_to_qwerty {
            timeout-ms = <50>;
            key-positions = <0 19>;
            bindings = <&to QWERTY>;
        };

        // Combo for bluetooth control
        // (i.e. switch among the devices).
        combo_bt_next {
            timeout-ms = <50>;
            key-positions = <9 19>;
            bindings = <&bt BT_NXT>;
        };
        combo_bt_prev {
            timeout-ms = <50>;
            key-positions = <9 29>;
            bindings = <&bt BT_PRV>;
        };
        combo_bt_out_tog {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&out OUT_TOG>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
    &kp Q        &kp W       &kp E        &kp R         &kp T  &kp Y  &kp U         &kp I        &kp O       &kp P
    &hm LGUI A   &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &kp G  &kp H  &hm LSHIFT J  &hm LCTRL K  &hm LALT L  &hm LGUI SEMI
    &lt MOUSE Z  &kp X       &kp C        &kp V         &kp B  &kp N  &kp M         &kp COMMA    &kp DOT     &lt MOUSE FSLH
                             &lt MEDIA ESC  &lt NAV SPACE  &lt FUN TAB    &lt SYM RET    &lt NUM BSPC   &lt BT DEL
            >;
        };

        colemak {
            bindings = <
    &kp Q        &kp W       &kp F        &kp P         &kp G  &kp J  &kp L         &kp U        &kp Y       &kp SEMI
    &hm LGUI A   &hm LALT R  &hm LCTRL S  &hm LSHIFT T  &kp D  &kp H  &hm LSHIFT N  &hm LCTRL E  &hm LALT I  &hm LGUI O
    &lt MOUSE Z  &kp X       &kp C        &kp V         &kp B  &kp K  &kp M         &kp COMMA    &kp DOT     &lt MOUSE FSLH
                             &lt MEDIA ESC  &lt NAV SPACE  &lt FUN TAB    &lt SYM RET    &lt NUM BSPC   &lt BT DEL
            >;
        };

        nav_layer {
            bindings = <
    &none     &none     &none      &none       &tog GAMEPAD  &kp K_APP  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none         &kp CAPS   &kp LEFT     &kp DOWN    &kp UP     &kp RIGHT
    &none     &none     &none      &none       &tog GAMEPAD  &kp INS    &kp HOME     &kp PG_DN   &kp PG_UP  &kp END
                        &none    &trans   &none    &kp RET  &kp DEL  &trans
            >;
        };

        num_layer {
            bindings = <
    &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT   &none  &none       &none      &none     &tog GAMEPAD
    &kp SQT    &kp N4  &kp N5  &kp N6  &kp EQUAL  &none  &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI
    &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH   &none  &none       &none      &none     &tog GAMEPAD
                       &kp DOT    &kp N0     &kp MINUS  &none      &trans     &trans
            >;
        };

        mouse_layer {
            // Hold Z (or /) to activate. Colemak labels:
            // move diamond: u=up ,=down n=left o=right
            // scroll:       m=left e=down i=up /=right
            bindings = <
    &none     &none     &none      &none       &none  &none  &none  &mmv MOVE_UP  &none  &none
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none  &none  &mmv MOVE_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &mmv MOVE_RIGHT
    &none     &none     &none      &none       &none  &none  &msc SCRL_LEFT  &mmv MOVE_DOWN  &none  &msc SCRL_RIGHT
                        &trans     &trans     &trans     &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        symbol_layer {
            bindings = <
    &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC  &none  &none       &none      &none     &tog GAMEPAD
    &kp DQT    &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS  &none  &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI
    &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE  &none  &none       &none      &none     &tog GAMEPAD
                         &kp LPAR   &kp RPAR   &kp UNDER  &trans     &none      &trans
            >;
        };

        media_layer {
            bindings = <
    &none       &none       &none         &none         &none       &none        &none       &none         &none         &none
    &kp K_MUTE  &kp K_PREV  &kp K_VOL_DN  &kp K_VOL_UP  &kp K_NEXT  &kp K_MUTE   &kp K_PREV  &kp K_VOL_DN  &kp K_VOL_UP  &kp K_NEXT
    &none       &none       &none         &none         &none       &bootloader  &none       &none         &none         &none
                            &trans      &kp K_PP    &kp K_STOP  &kp K_STOP  &kp K_PP    &trans
            >;
        };

        fun_layer {
            bindings = <
    &none     &none     &none      &none       &tog GAMEPAD  &kp PSCRN        &kp F7  &kp F8  &kp F9  &kp F12
    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none         &kp SLCK         &kp F4  &kp F5  &kp F6  &kp F11
    &none     &none     &none      &none       &tog GAMEPAD  &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10
                        &none   &none   &trans  &none   &none   &trans
            >;
        };

        gamepad {
            // QMK LAYER_GAMEPAD_BASE: no home row mods, ALT/SHIFT/CTRL on the
            // left main keys; thumbs reach gamepad L1/L2 + nav/sym.
            bindings = <
    &kp LALT    &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I      &kp O    &kp P
    &kp LSHIFT  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K      &kp L    &kp SEMI
    &kp LCTRL   &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                       &mo GP_L1      &lt NAV SPACE  &mo GP_L2      &lt SYM RET    &mo GP_L2      &tog GAMEPAD
            >;
        };

        gamepad_l1 {
            // QMK LAYER_GAMEPAD_L1: numbers for the left hand.
            bindings = <
    &trans  &kp N7  &trans  &kp N9  &kp ESC  &kp Y  &kp U  &kp I      &kp O    &kp P
    &trans  &trans  &trans  &trans  &kp TAB  &kp H  &kp J  &kp K      &kp L    &kp SEMI
    &trans  &kp N1  &kp N2  &kp N3  &kp N0   &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                    &mo GP_L1      &lt NAV SPACE  &none          &lt SYM RET    &lt NUM BSPC   &none
            >;
        };

        gamepad_l2 {
            // QMK LAYER_GAMEPAD_L2: function keys for the left hand.
            bindings = <
    &trans  &kp F7  &trans  &kp F9  &kp ESC  &kp Y  &kp U  &kp I      &kp O    &tog GAMEPAD
    &trans  &trans  &trans  &trans  &kp TAB  &kp H  &kp J  &kp K      &kp L    &kp SEMI
    &trans  &kp F1  &kp F2  &kp F3  &kp N0   &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                    &none          &lt NAV SPACE  &mo GP_L2      &lt SYM RET    &mo GP_L2      &none
            >;
        };

        bt_layer {
            // Hold the extra 6th thumb: z x c v select BT profiles 0-3,
            // b clears the bonds of the current profile.
            bindings = <
    &none         &none         &none         &none         &none       &none  &none  &none  &none  &none
    &none         &none         &none         &none         &none       &none  &none  &none  &none  &none
    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &none  &none  &none  &none  &none
                                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
